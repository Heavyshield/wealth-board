        "id": "per-danger",
        "label": "PER ≤ 28 (au-delà : zone dangereuse, réduction progressive)",
        "metric": "per",
        "op": "<=",
        "value": 28,
        "severity": "critical",
        "applies_to": {
          "asset_class": [
            "equity"
          ]
        },
        "why": "Au-delà de 28, la ligne est à réduire progressivement (décision de l'utilisateur)."
      },
      {
        "id": "pcf-max",
        "label": "Cours / flux de trésorerie d'exploitation ≤ 15",
        "metric": "pcf",
        "op": "<=",
        "value": 15,
        "require_positive": true,
        "applies_to": {
          "asset_class": [
            "equity"
          ]
        },
        "why": "Valorisation sur le cash réellement généré"
      },
      {
        "id": "leverage-max",
        "label": "Dette nette / EBITDA ≤ 2,5",
        "metric": "net_debt_ebitda",
        "op": "<=",
        "value": 2.5,
        "applies_to": {
          "asset_class": [
            "equity"
          ]
        },
        "why": "Endettement : une valeur négative = trésorerie nette (conforme)"
      }
    ]

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.schema.json",
  "title": "Wealth Board config",
  "type": "object",
  "required": [
    "schema_version",
    "revision",
    "updated_at",
    "base_currency",
    "locale",
    "envelopes",
    "asset_classes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "base_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "locale": {
      "type": "string"
    },
    "envelopes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "label": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "in_net_worth": {
            "type": "boolean",
            "description": "false = tracked but not counted in net worth (e.g. locked pension)"
          },
          "in_allocation": {
            "type": "boolean",
            "description": "false = counted in net worth, left out of allocation views/targets/caps (e.g. cash reserve)"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "asset_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "pricing"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "label": {
            "type": "string"
          },
          "pricing": {
            "enum": [
              "quote",
              "spot",
              "par"
            ]
          }
        }
      }
    },
    "regions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "by_country": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "by_pricing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "par": {
              "type": "string"
            },
            "spot": {
              "type": "string"
            },
            "quote": {
              "type": "string"
            }
          }
        },
        "unknown_label": {
          "type": "string"
        },
        "by_isin": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "ISIN -> region label (beats the ISIN country prefix; survives CSV re-imports)"
        }
      }
    },
    "allocation_targets": {
      "type": "object",
      "required": [
        "group_by",
        "weights"
      ],
      "additionalProperties": false,
      "properties": {
        "group_by": {
          "enum": [
            "asset_class",
            "envelope",
            "currency",
            "region"
          ]
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "charts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_slices": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "palette": {
          "type": "object",
          "required": [
            "light",
            "dark"
          ],
          "additionalProperties": false,
          "properties": {
            "light": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            },
            "dark": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        }
      }
    },
    "prices": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stale_after_hours": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quote": {
              "type": "number",
              "minimum": 0
            },
            "spot": {
              "type": "number",
              "minimum": 0
            },
            "fx": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sample_data": {
      "type": "boolean"
    },
    "rules": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "metrics_max_age_days": {
          "type": "integer",
          "minimum": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "metric",
              "op",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "label": {
                "type": "string"
              },
              "metric": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "op": {
                "enum": [
                  "<=",
                  "<",
                  ">=",
                  ">"
                ]
              },
              "value": {
                "type": "number"
              },
              "require_positive": {
                "type": "boolean"
              },
              "applies_to": {
                "$ref": "#/$defs/scope"
              },
              "why": {
                "type": "string"
              },
              "severity": {
                "enum": [
                  "warning",
                  "critical"
                ],
                "description": "critical = danger zone (red, top of À revoir); default warning"
              }
            }
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "type": {
            "enum": [
              "share_cap",
              "runway"
            ]
          },
          "label": {
            "type": "string"
          },
          "group_by": {
            "enum": [
              "asset_class",
              "envelope",
              "currency",
              "region"
            ]
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "max": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "min": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "monthly_budget": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "target_months": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "liquid": {
            "$ref": "#/$defs/scope"
          },
          "max_amount": {
            "type": "number",
            "minimum": 0
          },
          "min_amount": {
            "type": "number",
            "minimum": 0
          },
          "target_amount": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fx": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spot": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quote": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ttl_minutes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quote": {
              "type": "number",
              "minimum": 0
            },
            "spot": {
              "type": "number",
              "minimum": 0
            },
            "fx": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "auto_refresh": {
          "type": "boolean"
        },
        "preferred_exchanges": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Yahoo exchange codes, best first, used to pick a listing from an ISIN"
        }
      }
    },
    "imports": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "columns"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "envelope_default": {
            "type": "string"
          },
          "columns": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "isin": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "name": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "quantity": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "unit_cost": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "last_price": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "currency": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "ticker": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "required": {
            "type": "array",
            "items": {
              "enum": [
                "isin",
                "name",
                "quantity",
                "unit_cost",
                "last_price",
                "currency",
                "ticker"
              ]
            }
          },
          "update_fields": {
            "type": "array",
            "items": {
              "enum": [
                "quantity",
                "unit_cost"
              ]
            }
          },
          "asset_class_default": {
            "type": "string"
          },
          "etf_name_pattern": {
            "type": "string"
          }
        }
      }
    },
    "drive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client_id": {
          "type": "string",
          "description": "Optional Google OAuth client ID (desktop login). Public, restricted to authorized origins."
        }
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_class": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "envelope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags_exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
